{
  "name": "crypto-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:web": "vite",
    "start": "bun run src/index.ts",
    "start:prod": "bun run db:deploy && bun run src/index.ts",
    "build": "bun run build:web",
    "build:web": "vite build",
    "seed": "bun run scripts/seed.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "bun run scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-router": "^1.170.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "nanoid": "^6.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.14",
    "viem": "^2.55.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13"
  }
}
