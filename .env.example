# Copy to .env and fill in. NEVER commit the real .env.
#
# On Railway these are service variables, not a file. Only DATABASE_URL,
# HD_MNEMONIC and ADMIN_PASSWORD are required there — PORT is injected by the
# platform and everything else has a default. See README -> Deploying to Railway.
#
# This URL matches the Postgres service in docker-compose.yml. On Railway,
# reference the database service instead (${{Postgres.DATABASE_URL}}); if you use
# the public proxy URL rather than the private one, append ?sslmode=require.
DATABASE_URL=postgres://postgres:gateway@localhost:5433/gateway

# Alchemy (one API key per app/network)
ALCHEMY_SEPOLIA_KEY=xxxx
ALCHEMY_BASE_SEPOLIA_KEY=xxxx

# TESTNET ONLY. Generate a NEW mnemonic for this — never reuse a real one.
# The default below is the well-known public hardhat/anvil test mnemonic.
HD_MNEMONIC="test test test test test test test test test test test junk"

# Business parameters
QUOTE_TTL_MINUTES=15
GRACE_TTL_MINUTES=90
SPREAD_BPS=75              # 0.75% spread over market rate
DUST_TOLERANCE_BPS=50     # 0.5%: considered complete from 99.5%
PORT=3000                 # injected by Railway; do not set it there

# Gate for the /admin console. It is read-only but cross-merchant and shows
# operational internals, so a production boot refuses to start without a
# password. Unset in local development leaves the console open, as before.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# Canonical public origin for the checkout links returned as `checkout_url`,
# no trailing slash (e.g. https://pay.example.com). Unset, the origin comes from
# the request's forwarded scheme/host, which is already correct behind Railway's
# edge — set it only to pin links to one domain.
# PUBLIC_BASE_URL=

# Optional last-resort USD->COP rate, used only if every FX provider is
# unreachable and no cached rate is fresh. Unset = refuse to quote rather
# than guess. Rates are otherwise (asset->USD from CoinGecko) x (USD->COP).
# FALLBACK_USD_COP=3213

# Tron (network `tron-nile`, USDT TRC-20). TronGrid serves the public testnet
# without a key; set one only if you hit the per-IP rate limit.
# TRONGRID_API_KEY=

# EVM backfill window and the largest eth_getLogs range the provider allows.
# Alchemy's free tier caps getLogs at 10 blocks, so the backfill walks the
# window in chunks of LOG_RANGE_BLOCKS. Raise both on a paid plan.
# BACKFILL_BLOCKS=50
# LOG_RANGE_BLOCKS=10

# ---- Cost dials -------------------------------------------------------
# Polling cadences in seconds. Workers skip the provider entirely when there is
# nothing open to look at, so these only bite while payments are in flight.
#
# BACKFILL_INTERVAL_SEC  EVM only. Live detection is the WebSocket; this just
#                        catches what a reconnection missed, so it can be slow.
#                        Each run costs 1 + (BACKFILL_BLOCKS/LOG_RANGE_BLOCKS)
#                        calls, and getLogs is the priciest method there is.
# TRON_POLL_INTERVAL_SEC Tron has no WebSocket, so this IS detection latency for
#                        a payer who closed the tab. The checkout's "ya pagué"
#                        button covers the common case instantly, which is what
#                        lets this run slowly.
# CONFIRMER_INTERVAL_SEC How often maturing deposits are re-checked. Only ticks
#                        while an unconfirmed deposit exists.
# BACKFILL_INTERVAL_SEC=300
# TRON_POLL_INTERVAL_SEC=60
# CONFIRMER_INTERVAL_SEC=30
