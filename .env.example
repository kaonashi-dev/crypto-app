# Copy to .env and fill in. NEVER commit the real .env.
#
# On Railway these are service variables, not a file. Only DATABASE_URL,
# HD_MNEMONIC and ADMIN_PASSWORD are required there — PORT is injected by the
# platform and everything else has a default. See README -> Deploying to Railway.
#
# This URL matches the Postgres service in docker-compose.yml. On Railway,
# reference the database service instead (${{Postgres.DATABASE_URL}}); if you use
# the public proxy URL rather than the private one, append ?sslmode=require.
DATABASE_URL=postgres://postgres:gateway@localhost:5433/gateway

# Alchemy (one API key per app/network). A network whose key is unset still
# accepts payments and derives addresses — it just has nothing watching it, and
# the boot says so by name.
ALCHEMY_SEPOLIA_KEY=xxxx
ALCHEMY_BASE_SEPOLIA_KEY=xxxx
ALCHEMY_BSC_TESTNET_KEY=xxxx
ALCHEMY_AMOY_KEY=xxxx

# Mainnet keys. Only read when ENABLE_MAINNETS is on (see below); until then
# `bsc` and `polygon` are defined but not served.
# ALCHEMY_BSC_KEY=
# ALCHEMY_POLYGON_KEY=

# Serve the mainnet networks (`bsc`, `polygon`) as well as the testnets.
#
# Off by default, and not a formality: an offered network is one the API quotes
# and derives a real receiving address on. Switching this on therefore also arms
# the seed check — a boot with a publicly known HD_MNEMONIC and any mainnet
# offered refuses to start, because every address it hands a payer would be
# spendable by anyone. Generate a private mnemonic first.
# ENABLE_MAINNETS=true

# The seed every receiving address is derived from. Generate one — never reuse a
# mnemonic that has held real funds, and never the hardhat/anvil phrase that used
# to sit here: it is published, so its addresses arrive with other people's
# history and anyone can sweep what they receive.
#
#   bun run mnemonic:new --write     # writes the line below, never prints it
#   bun run mnemonic:new             # prints it instead, to paste elsewhere
#
# The boot refuses to start on an invalid phrase, and on a public one if the
# build serves any mainnet. The database also binds this mnemonic to its
# derivation counter: swapping it later fails loudly rather than issuing
# addresses from a tree the counter does not belong to.
HD_MNEMONIC=

# Business parameters
QUOTE_TTL_MINUTES=15
GRACE_TTL_MINUTES=90
SPREAD_BPS=75              # 0.75% spread over market rate
DUST_TOLERANCE_BPS=50     # 0.5%: considered complete from 99.5%
PORT=3000                 # injected by Railway; do not set it there

# Sign-in for the /admin console. It is cross-merchant and shows operational
# internals, so a production boot refuses to start without a password. Unset in
# local development leaves the console open *for reading*, as before.
#
# It no longer only gates reading. The console can create and edit merchants,
# rotate their credentials and issue payments, and every one of those writes an
# `admin_audit_log` row naming the operator — so with no password there is no
# identity, and writes are refused with 403 rather than recorded anonymously.
# Set this locally if you want to use the Merchants or Build views.
#
# Every boot creates this operator in `admin_users` (password stored as an
# argon2id hash) and keeps it in step with the value below — so changing
# ADMIN_PASSWORD and restarting is also how you reset the password, and doing so
# revokes that operator's open sessions. Sessions are cookies backed by rows in
# `admin_sessions`; ADMIN_SESSION_TTL_HOURS is how long one lasts, sliding while
# it is in use.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_SESSION_TTL_HOURS=12

# Canonical public origin for the checkout links returned as `checkout_url`,
# no trailing slash (e.g. https://pay.example.com). Unset, the origin comes from
# the request's forwarded scheme/host, which is already correct behind Railway's
# edge — set it only to pin links to one domain.
# PUBLIC_BASE_URL=

# Optional last-resort USD->COP rate, used only if every FX provider is
# unreachable and no cached rate is fresh. Unset = refuse to quote rather
# than guess. Rates are otherwise (asset->USD from CoinGecko) x (USD->COP).
# FALLBACK_USD_COP=3213

# Tron (network `tron-nile`, USDT TRC-20 and native TRX). TronGrid serves the
# public testnet without a key; set one only if you hit the per-IP rate limit.
# Native TRX costs one extra call per open TRX payment per poll.
# TRONGRID_API_KEY=

# EVM backfill window and the largest eth_getLogs range the provider allows.
# Alchemy's free tier caps getLogs at 10 blocks, so the backfill walks the
# window in chunks of LOG_RANGE_BLOCKS. Raise both on a paid plan.
# BACKFILL_BLOCKS=50
# LOG_RANGE_BLOCKS=10

# Native coins (BNB, POL) are not events, so they cannot be filtered by log:
# finding one means reading whole blocks and looking at every transaction. This
# is how far back the native backfill re-reads, and it is deliberately much
# smaller than BACKFILL_BLOCKS because each block is its own call — there is no
# range query to amortise it. The live path is driven by new-block
# notifications and reads nothing at all while no payment is quoted in a
# native coin.
# NATIVE_BACKFILL_BLOCKS=20

# ---- Cost dials -------------------------------------------------------
# Polling cadences in seconds. Workers skip the provider entirely when there is
# nothing open to look at, so these only bite while payments are in flight.
#
# BACKFILL_INTERVAL_SEC  EVM only. Live detection is the WebSocket; this just
#                        catches what a reconnection missed, so it can be slow.
#                        Each run costs 1 + (BACKFILL_BLOCKS/LOG_RANGE_BLOCKS)
#                        calls, and getLogs is the priciest method there is.
# TRON_POLL_INTERVAL_SEC Tron has no WebSocket, so this IS detection latency for
#                        a payer who closed the tab. The checkout's "ya pagué"
#                        button covers the common case instantly, which is what
#                        lets this run slowly.
# CONFIRMER_INTERVAL_SEC How often maturing deposits are re-checked. Only ticks
#                        while an unconfirmed deposit exists.
# BACKFILL_INTERVAL_SEC=300
# TRON_POLL_INTERVAL_SEC=60
# CONFIRMER_INTERVAL_SEC=30

# ---- Logging and telemetry --------------------------------------------
# All optional; the defaults are right for both local development and Railway.
# See docs/architecture/observability.md for the record shape and the attribute conventions.
#
# LOG_LEVEL   trace | debug | info | warn | error | fatal. Default: debug
#             locally, info in production. Accepts per-scope overrides as a
#             comma list, longest matching prefix wins:
#               LOG_LEVEL=info,payments=debug,db=trace
#               LOG_LEVEL=warn,watcher=trace     # one network family, verbose
#             Scopes: config, db, http, auth, payments, rates, wallet, webhooks,
#             trongrid, watcher:<network>, confirmer:<network>,
#             tron-watcher:<network>, tron-confirmer:<network>,
#             supervisor:<network>, gateway, metrics.
# LOG_FORMAT  pretty | json. Default: pretty on a TTY, json otherwise — so a
#             container ships parseable lines without being told to.
# LOG_COLOR   0 disables ANSI colour, 1 forces it on without a TTY. NO_COLOR
#             is honoured.
# LOG_BUFFER  Records kept in memory for GET /admin/api/logs. Default 500, 0 off.
# LOG_SILENT  1 drops the console sink entirely.
# HEARTBEAT_INTERVAL_SEC  Liveness line with counter deltas. Default 60, 0 off.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# Optional OTLP/HTTP export of the same records to any OpenTelemetry collector
# (Collector, Grafana Alloy, Honeycomb, SigNoz, Uptrace…). Unset = off; nothing
# leaves the process. No SDK is involved: the exporter posts the documented JSON
# envelope, so this adds no dependency and no startup cost when disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=      # full URL if not <base>/v1/logs
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...,x-tenant=...
# OTEL_BSP_SCHEDULE_DELAY=5000           # flush interval, ms
# OTEL_SERVICE_NAME=crypto-gateway
# SERVICE_VERSION=                       # defaults to the Railway commit sha

# ---- Treasury sweeping ------------------------------------------------
# Consolidating per-payment deposit addresses into one treasury wallet.
# See docs/design/SWEEPING-PLAN.md; everything here is off by default and the gateway
# behaves exactly as it always has with none of it set.
#
# The two switches are not the same switch:
#
#   SWEEP_ENABLED unset            The sweeper never starts. Funds accumulate at
#                                  deposit addresses, as they do today.
#   SWEEP_ENABLED + SWEEP_DRY_RUN  Candidates are selected and recorded with
#                                  their reasons. Nothing is ever signed. This
#                                  is where to start, and it is safe anywhere.
#   SWEEP_ENABLED alone            Full execution: authorize, broadcast, confirm.
#
# Sweeping cannot affect settlement in any mode. Settlement is event-sourced
# from Transfer logs and never reads a balance, so emptying an address — even
# mid-grace on a partially paid payment — changes nothing about what it settles
# at, and a later top-up to the same address is still detected and credited.
#
# Which pairings can actually be swept is registry data, not a switch: a
# (network, asset) is consolidated only once `sweep` is set on it in
# src/config.ts, which happens after `bun run scripts/sweep-probe.ts` has
# confirmed the mechanism against the contract. GET /admin/api/stats reports the
# current list as `config.sweep_pairings`.
# SWEEP_ENABLED=1
# SWEEP_DRY_RUN=1                # default 1; set 0 to actually sign and send
# SWEEP_INTERVAL_SEC=120
# SWEEP_MIN_USD=5                # floor; below this, value accumulates
# SWEEP_MAX_COST_BPS=200         # refuse if the fee exceeds 2% of what it moves
# SWEEP_GAS_CEILING_GWEI=        # global override of the per-network ceiling
# SWEEP_MAX_ATTEMPTS=8           # matches the webhook dead-letter convention
# SWEEP_NATIVE_HEADROOM_BPS=500  # gas headroom when sweeping a native coin
# SWEEP_AUTH_TTL_SEC=86400       # how long a signed EIP-3009 authorization lasts

# Where swept value lands. Required whenever SWEEP_ENABLED is set for a served
# family — the preflight refuses to boot without them. The gateway never holds a
# key for these addresses: they are destinations, never sources, so no
# compromise of this process reaches the consolidated funds.
# TREASURY_ADDRESS_EVM=0x...
# TREASURY_ADDRESS_TRON=T...

# Which signer holds the *deposit* keys. `local` derives them in-process from
# HD_MNEMONIC — fine for a testnet, unacceptable for real value, because it
# gives an always-on process the ability to sign movements of money. The
# preflight refuses to boot on SWEEP_ENABLED + a served mainnet + local signing,
# so that boundary is enforced rather than documented. `remote` is the KMS/HSM/
# MPC seam and is not implemented yet.
# SWEEP_SIGNER=local
#
# Gas for sweeps is paid by a relayer derived from HD_MNEMONIC at BIP-44 account
# 1 (m/44'/60'/1'/0/0 and m/44'/195'/1'/0/0), which cannot collide with any
# address issued to a payer — those come from account 0, and the derivation
# counter only ever walks that account. Fund it with a little of each chain's
# fee currency; the sweeper logs the address and warns when it runs dry.

# Reconciliation: on-chain balances vs the ledger, per deposit address. Read-only
# and independently useful, so it can run with the sweeper itself switched off.
# This is what surfaces value that arrived on a chain no watcher covers — the
# same BIP-32 key yields the same address on every EVM chain, so a payer can send
# to a mainnet this gateway does not serve and nothing would otherwise notice.
# SWEEP_RECON_ENABLED=1
# SWEEP_RECON_INTERVAL_SEC=3600
# SWEEP_RECON_MAX_ADDRESSES=200  # per tick; a cursor rotates through the rest
