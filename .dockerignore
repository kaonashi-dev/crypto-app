# Dependencies and build output are produced inside the image, never copied in.
node_modules/
web/dist/
node_modules/.vite/
*.tsbuildinfo

# Secrets. Railway supplies configuration as environment variables; a .env must
# never be baked into an image layer.
.env
.env.local
.env.*.local

.git/
.gitignore
.github/

# Not needed at build or runtime.
docs/
README.md
AGENTS.md
docker-compose.yml
Dockerfile
.dockerignore
*.log
.DS_Store
